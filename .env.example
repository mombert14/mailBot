# Kopiera till .env och fyll i dina värden. .env checkas aldrig in.

# Google Cloud-projektets ID (inte numret, inte visningsnamnet)
GCP_PROJECT_ID=mitt-projekt-id
PUBSUB_TOPIC=gmail-notifications
PUBSUB_SUBSCRIPTION=gmail-pull

# Från platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Frivillig - notiser till Discord
DISCORD_WEBHOOK=
